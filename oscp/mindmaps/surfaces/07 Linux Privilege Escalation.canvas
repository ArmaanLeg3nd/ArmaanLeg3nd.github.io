    },
    {
      "id": "linux-sudo",
      "type": "text",
      "x": 550,
      "y": 633,
      "width": 760,
      "height": 76,
      "text": "[[notes/linux-privesc.md#linux-sudo|Use an allowed sudo operation to cross a privilege boundary]]"
    },
    {
