      "y": 422,
      "width": 760,
      "height": 76,
      "text": "[[notes/linux-privesc.md#linux-secrets|Recover credentials from Linux user, service and process trails]]"
    },
    {
      "id": "linux-privesc-family-0",
      "type": "text",
      "x": 20,
      "y": 304,
      "width": 360,
      "height": 76,
      "text": "Identity, permissions and secret sources",
