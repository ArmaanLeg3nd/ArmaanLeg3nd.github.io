      "x": 4715,
      "y": 18817,
      "width": 4080,
      "height": 1731,
      "label": "Infer SQL data through boolean or time-based differences",
      "color": "4"
    },
    {
      "id": "method-group:sql-os",
      "type": "group",
      "x": 4715,
      "y": 20673,
      "width": 4080,
      "height": 1424,
      "label": "Convert database rights into a file or operating-system effect",
      "color": "4"
    },
    {
