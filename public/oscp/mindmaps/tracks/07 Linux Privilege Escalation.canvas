    },
    {
      "id": "flow:linux-privesc:check-1--check-1-fallback",
      "fromNode": "flow:linux-privesc:check-1",
      "fromSide": "right",
      "toNode": "flow:linux-privesc:check-1-fallback",
      "toSide": "left",
      "toEnd": "arrow",
      "label": "No useful sudo rule: check SUID/SGID and capabilities; do not keep trying sudo payloads."
    },
    {
      "id": "flow:linux-privesc:check-1--check-2",
      "fromNode": "flow:linux-privesc:check-1",
      "fromSide": "bottom",
      "toNode": "flow:linux-privesc:check-2",
      "toSide": "top",
      "toEnd": "arrow",
      "label": "continue coverage"
    },
    {
      "id": "flow:linux-privesc:check-2--check-2-finding-0",
      "fromNode": "flow:linux-privesc:check-2",
      "fromSide": "right",
      "toNode": "flow:linux-privesc:check-2-finding-0",
      "toSide": "left",
      "toEnd": "arrow",
      "label": "UID=0 repeatedly invokes a script under /opt or another path"
    },
    {
      "id": "flow:linux-privesc:check-2--check-2-finding-1",
      "fromNode": "flow:linux-privesc:check-2",
      "fromSide": "right",
      "toNode": "flow:linux-privesc:check-2-finding-1",
      "toSide": "left",
      "toEnd": "arrow",
      "label": "A privileged job invokes a helper without an absolute path"
    },
    {
      "id": "flow:linux-privesc:check-2--check-2-fallback",
      "fromNode": "flow:linux-privesc:check-2",
