    {
      "id": "flow:linux-privesc:check-1--check-1-finding-1",
      "fromNode": "flow:linux-privesc:check-1",
      "fromSide": "right",
      "toNode": "flow:linux-privesc:check-1-finding-1",
      "toSide": "left",
