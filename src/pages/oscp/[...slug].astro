---
import {plainPages,plainURL,renderPlain,renderIndex,renderPageIndex} from '../../lib/oscp-plain';
export function getStaticPaths(){return plainPages.map(page=>({params:{slug:page.slug||undefined},props:{page}}));}
const {page}=Astro.props;
const {html,headings}=await renderPlain(page);
const navigation=renderIndex(page,headings);
const contents=renderPageIndex(page,headings);
---
<!doctype html>
<html lang="en">
 <head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="color-scheme" content="light" />
  <title>{page.title} — OSCP Reference</title>
  <meta name="description" content="Numbered OSCP chapters, baselines, variants and result-specific next sections." />
  <link rel="canonical" href={new URL(plainURL(page),Astro.site)} />
 </head>
 <body>
  <a class="skip" href="#document">Skip to document</a>
  <header class="reference-header">
   <a class="reference-title" href="/oscp/">OSCP Reference</a>
   <div class="reference-find"><form id="reference-search" role="search" action="#"><label class="search-label" for="reference-query">Search the reference</label><div class="search-row"><input id="reference-query" type="search" maxlength="160" autocomplete="off" placeholder="Section, tool, field or error…" aria-controls="reference-results" aria-describedby="reference-search-status" /><button type="submit">Find</button><kbd title="Focus search">/</kbd></div></form><div class="search-feedback" hidden><p id="reference-search-status" role="status" aria-live="polite"></p><ol id="reference-results" hidden></ol></div><noscript>Use your browser’s Find command or the chapter index.</noscript></div>
  </header>
  <aside id="reference-index">
   <nav aria-label="Reference index" set:html={navigation} />
   <hr /><p><a href="/">Website</a> · <a href="https://github.com/ArmaanLeg3nd/OSCP-Exploitation-Reference">Source</a></p>
  </aside>
  <aside id="page-index"><strong>On this page</strong><nav aria-label="On this page" set:html={contents} /></aside>
  <main id="document" tabindex="-1"><div class="method-controls" hidden><button type="button" data-disclosure-action="expand">Expand all methods and variants</button> <button type="button" data-disclosure-action="collapse">Collapse all methods and variants</button></div><article set:html={html} /><hr /><p><a href="#document">Top of document</a> · <a href="/oscp/">Reference home</a></p></main>
 </body>
</html>
<script>import "../../scripts/oscp-plain-client.ts";</script>
<style is:global>
 .command-pair{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:1.5rem;align-items:start}.command-action,.command-reading{min-width:0}.command-reading{font-size:.95em;border-left:1px solid #ccc;padding-left:1rem}.command-reading blockquote{border:0;padding:0;margin:.7rem 0}.command-action pre{margin-top:.7rem} @media(max-width:1250px){.command-pair{display:block}.command-reading{border-left:2px solid #aaa}}
 [data-method-fold]{border-top:1px solid #888;padding:.75rem 0}[data-method-fold]>summary{padding:.35rem .5rem;background:#f5f5f5;border-bottom:1px solid #bbb}[data-method-fold]>summary::marker{color:#0000ee}[data-method-fold]>summary :is(h2,h3,h4,h5){display:inline;margin:0;font-weight:bold}article summary{font-weight:bold}[data-study-approach]>summary{padding:.5rem;border-bottom:1px solid #bbb;background:#f5f5f5}.approach-heading{font-size:1em;font-weight:bold}.method-choice-cue{display:block;font-size:.9em;font-weight:normal;margin:.3rem 0 .3rem 1rem;max-width:85ch}.method-controls{font-size:14px;margin:.5rem 0} @media print{aside,.method-controls,.reference-find{display:none!important}main{margin:0!important;padding:0!important}.command-pair{display:block!important}}
 .reference-cue{font-weight:bold;padding:.05em .2em;border-radius:.12em;-webkit-box-decoration-break:clone;box-decoration-break:clone}.cue-critical{color:#861b1b;background:#fde6e6}.cue-condition{color:#684500;background:#fff0c2}.cue-evidence{color:#1d5133;background:#e3f2e7}article :is(h2,h3,h4,h5,h6):target{background:#fff5cf;outline:2px solid #e1ce8b;outline-offset:3px}article ::selection{background:#fff0b3;color:#000} @media print{.reference-cue{color:#000!important;background:transparent!important;text-decoration:underline}article :target{background:transparent!important;outline:0!important}}
 :root {color-scheme:light}
 .method-label{display:block;font-size:.75em;font-weight:normal;color:#586273;margin:.2rem 0}.method-label::before{content:'Method: '}
 .reference-header{position:fixed;inset:0 0 auto;z-index:5;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,44rem) minmax(0,1fr);align-items:center;gap:1rem;padding:.6rem 1rem;box-sizing:border-box;background:white;border-bottom:1px solid #888}.reference-title{font-weight:bold;font-size:16px}.reference-find{position:relative;min-width:0;font-size:14px}.search-label{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}.search-row{display:flex;align-items:center;gap:.5rem}.reference-find input{box-sizing:border-box;min-width:0;width:100%;font:16px/1.4 Arial,sans-serif;padding:.4rem .6rem;border:1px solid #888;border-radius:2px;background:white;color:black}.reference-find button{font:14px Arial,sans-serif;padding:.5rem .7rem}.reference-find kbd{border:1px solid #aaa;padding:0 .35rem}.search-feedback{position:absolute;top:calc(100% + .65rem);left:0;right:0;max-height:60dvh;overflow:auto;background:white;border:1px solid #888;padding:0 .8rem;box-shadow:0 3px 8px #0002}.reference-find ol{padding-left:1.2rem}.reference-find li{margin:.6rem 0}.reference-find input:focus-visible{outline:2px solid #0000ee;outline-offset:2px}
 [data-command-context]{font-size:.9em;border-left:2px solid #aaa;padding-left:.6rem} [data-command-context] p{margin:.4rem 0}
 #page-index [aria-current="location"]{font-weight:bold;background:#ffffcc}
 html {--reference-header-height:62px;background:white;color:black;scroll-padding-top:calc(var(--reference-header-height) + 1rem)}
 body {margin:0;padding-top:var(--reference-header-height);font:17px/1.5 "Times New Roman",Times,serif}
 a,a:visited {color:#0000ee;text-decoration:underline}
 a:focus-visible,summary:focus-visible {outline:2px solid black;outline-offset:3px}
 aside {position:fixed;top:var(--reference-header-height);bottom:0;box-sizing:border-box;padding:.75rem 1rem;overflow:auto;background:white}
 #reference-index {left:0;width:18rem;border-right:1px solid #888}
 #page-index {right:0;width:15rem;border-left:1px solid #888}
 aside>p:first-child {margin-top:0}
 nav {font-size:14px;line-height:1.4;overflow-wrap:anywhere}
 nav ul {padding-left:1rem;margin:.35rem 0} nav li {margin:.3rem 0}
 nav summary,article summary {cursor:pointer} nav [aria-current="page"] {font-weight:bold}
 main {margin:0 15rem 0 18rem;padding:1rem 1.5rem 3rem;min-width:0}
 article>p{max-width:85ch} article {max-width:none;min-width:0;overflow-wrap:anywhere}
 h1 {font-size:1.9em;line-height:1.2} h2 {font-size:1.45em;margin-top:1.7em} h3 {font-size:1.15em;margin-top:1.5em} h4,h5,h6 {font-size:1em;margin-top:1.3em}
 pre,code {font-family:"Courier New",Courier,monospace;font-size:.9em}
 pre {padding:.7rem;border:1px solid #aaa;background:#f5f5f5;overflow-x:auto;white-space:pre;overflow-wrap:normal}
 table {display:block;max-width:100%;overflow-x:auto;border-collapse:collapse;margin:1rem 0}
 th,td {border:1px solid #aaa;padding:.35rem .55rem;vertical-align:top;text-align:left}
 th {background:#eee} blockquote {margin-left:0;padding-left:1rem;border-left:2px solid #aaa}
 img,svg {max-width:100%;height:auto} article details {margin:1rem 0}
 .skip {position:fixed;left:-10000px;top:0;z-index:6;background:white;padding:.5rem}.skip:focus {left:0}
 @media(max-width:1150px){.reference-header{grid-template-columns:9rem minmax(0,1fr) 9rem}}
 @media (min-width:761px) and (max-width:1150px) {#reference-index{width:14rem}#page-index{width:15rem}main{margin-left:14rem;margin-right:15rem}}
 @media (max-width:760px) {
  html{--reference-header-height:94px;scroll-padding-top:calc(var(--reference-header-height) + 30dvh + 1rem)}
  .reference-header{grid-template-columns:minmax(0,1fr);gap:.25rem;padding:.4rem .5rem}.reference-title{font-size:14px;justify-self:center}.reference-find kbd{display:none}
  aside{top:var(--reference-header-height);bottom:auto;height:30vh;height:30dvh;z-index:1;padding:.5rem}
  #reference-index{left:0;width:50%;border-bottom:1px solid #888}
  #page-index{right:0;width:50%;border-left:0;border-bottom:1px solid #888}
  main{margin:0;padding:calc(30vh + 1rem) 1rem 2rem;padding-top:calc(30dvh + 1rem)}
  body{font-size:16px}nav{font-size:13px}
 }
 @media print{.reference-header{display:none!important}body{padding-top:0!important}}
</style>
