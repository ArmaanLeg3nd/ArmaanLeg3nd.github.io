---
import {plainPages,plainURL,renderPlain,renderIndex} from '../../lib/oscp-plain';
export function getStaticPaths() {
  return plainPages.map(page=>({params:{slug:page.slug||undefined},props:{page}}));
}
const {page}=Astro.props;
const {html,headings}=await renderPlain(page);
const navigation=renderIndex(page,headings);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{page.title} — OSCP Reference</title>
    <meta name="description" content="Plain OSCP reference: commands, explanations, interpretation and next checks." />
    <link rel="canonical" href={new URL(plainURL(page),Astro.site)} />
  </head>
  <body>
    <a class="skip" href="#document">Skip to document</a>
    <aside id="reference-index">
      <p><strong><a href="/oscp/">OSCP Reference</a></strong></p>
      <nav aria-label="Reference index" set:html={navigation} />
      <hr />
      <p><a href="/">Website</a> · <a href="https://github.com/ArmaanLeg3nd/OSCP-Exploitation-Reference">Source</a></p>
    </aside>
    <main id="document" tabindex="-1">
      <article set:html={html} />
      <hr />
      <p><a href="#document">Top of document</a> · <a href="/oscp/">Reference home</a></p>
    </main>
  </body>
</html>
<style is:global>
  :root { color-scheme: light; }
  html { background: white; color: black; scroll-padding-top: 1rem; }
  body { margin: 0; font: 17px/1.5 "Times New Roman", Times, serif; }
  a, a:visited { color: #0000ee; text-decoration: underline; }
  a:focus-visible, summary:focus-visible { outline: 2px solid black; outline-offset: 3px; }
  #reference-index {
    position: fixed; inset: 0 auto 0 0; width: 19rem; box-sizing: border-box;
    padding: .75rem 1rem; overflow: auto; background: #fff; border-right: 1px solid #888;
  }
  #reference-index > p:first-child { margin-top: 0; }
  nav { font-size: 15px; line-height: 1.4; overflow-wrap: anywhere; }
  nav ul { padding-left: 1.15rem; margin: .35rem 0; }
  nav > ul { padding-left: 1rem; }
  nav li { margin: .3rem 0; }
  nav summary { cursor: pointer; }
  nav [aria-current="page"] { font-weight: bold; }
  main { margin-left: 19rem; padding: 1rem 2rem 3rem; min-width: 0; }
  article { max-width: 85ch; min-width: 0; overflow-wrap: anywhere; }
  h1 { font-size: 2em; line-height: 1.15; }
  h2 { font-size: 1.5em; margin-top: 1.7em; }
  h3 { font-size: 1.2em; margin-top: 1.5em; }
  h4, h5, h6 { font-size: 1em; margin-top: 1.3em; }
  pre, code { font-family: "Courier New", Courier, monospace; font-size: .9em; }
  pre { padding: .7rem; border: 1px solid #aaa; background: #f5f5f5; overflow-x: auto; white-space: pre; overflow-wrap: normal; }
  table { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; margin: 1rem 0; }
  th, td { border: 1px solid #aaa; padding: .35rem .55rem; vertical-align: top; text-align: left; }
  th { background: #eee; }
  blockquote { margin-left: 0; padding-left: 1rem; border-left: 2px solid #aaa; }
  img, svg { max-width: 100%; height: auto; }
  article details { margin: 1rem 0; }
  article summary { cursor: pointer; }
  .skip { position: fixed; left: -10000px; top: 0; z-index: 2; background: white; padding: .5rem; }
  .skip:focus { left: 0; }
  @media (max-width: 700px) {
    html { scroll-padding-top: calc(32dvh + 1rem); }
    #reference-index { inset: 0 0 auto; width: 100%; height: 32vh; height: 32dvh; border-right: 0; border-bottom: 1px solid #888; z-index: 1; }
    main { margin-left: 0; padding: calc(32vh + 1rem) 1rem 2rem; padding-top: calc(32dvh + 1rem); }
    body { font-size: 16px; }
  }
</style>
