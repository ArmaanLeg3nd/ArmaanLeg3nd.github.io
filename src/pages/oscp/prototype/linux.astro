---
import {plainPages,renderPlain} from '../../../lib/oscp-plain';
const {html,headings}=await renderPlain(plainPages.find(p=>p.path==='cheatsheets/linux-privesc.md')!);
const topics=[['Discovery','discovery-scanning'],['Services','service-opportunities'],['Web','web-mapping'],['Credentials','credentials-cracking'],['Shells & transfers','shells-payloads'],['Linux escalation','linux-privesc'],['Windows escalation','windows-privesc'],['Active Directory','ad-investigation'],['Pivoting','pivoting'],['Evidence','evidence-reporting']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex"/><title>Linux escalation · Reference prototype</title></head><body>
<a class="skip" href="#document">Skip to tasks</a>
<header class="reference-header"><a href="/oscp/" class="brand">OSCP Reference</a><div class="reference-find"><form id="reference-search" role="search"><label for="reference-query" class="sr-only">Search the reference</label><input id="reference-query" type="search" maxlength="160" placeholder="Search a task, command or error…" autocomplete="off"/><button>Find</button></form><div class="search-feedback" hidden><p id="reference-search-status" role="status" aria-live="polite"></p><ol id="reference-results" hidden></ol></div></div><a class="compare" href="/oscp/cheatsheets/linux-privesc/">Compare original ↗</a></header>
<aside id="reference-index"><p class="eyebrow">WORKFLOW</p><nav aria-label="Reference index">{topics.map(([title,slug])=><a href={slug==='linux-privesc'?'#document':'/oscp/cheatsheets/'+slug+'/'} aria-current={slug==='linux-privesc'?'page':undefined}>{title}</a>)}</nav><div class="library"><a href="/oscp/">Browse full library ↗</a><p>Procedures, study notes<br/>and numbered sections.</p></div></aside>
<main id="document" tabindex="-1"><p class="eyebrow">PROTOTYPE · LOCAL PRIVILEGE ESCALATION</p><h1>Linux privilege escalation</h1><p class="lede">Find a promising permission or credential, validate its conditions, then verify the resulting identity.</p>
<section class="start"><div><strong>Starting with a shell?</strong><p>Establish your identity and host context. Then follow the evidence you find.</p><a href="#first-pass">Start the first pass →</a></div><div><strong>Already have a finding?</strong><p>Open its task below. Read the baseline with its interpretation; expand alternatives when needed.</p><a href="#sudo">Inspect a sudo finding →</a></div></section>
<div class="task-heading"><h2>Choose an investigation</h2><span>Open only what you need</span></div><article set:html={html}/>
<section class="deeper"><strong>Understand the mechanism</strong><p><a href="/oscp/notes/methods/linux-privesc/">Study methods</a> · <a href="/oscp/reference/05-local-privilege-escalation/">Complete procedures</a> · <a href="/oscp/notes/Master_Notes/">Master Notes</a></p></section></main>
<aside id="page-index"><p class="eyebrow">IN THIS TOPIC</p><nav aria-label="On this page">{headings.filter(h=>h.depth===2).map(h=><a href={'#'+h.slug}>{h.text.replace(/^10\.9\./,'')}</a>)}</nav></aside>
</body></html>
<script>
const article=document.querySelector('article')!;
const cues:Record<string,string>={'early-tool-assisted-pass':'Collect candidates; manually validate the useful finding.','candidate-proof':'Connect control, privileged execution and a reliable trigger.','first-pass':'Identify your user, host, routes, processes and sudo rights.','prove-effective-permissions':'Check the exact file, parent directory, ACLs and mount restrictions.','credentials-and-files':'Inspect application configuration, histories, processes and accessible sessions.','sudo':'Inspect allowed commands, run-as identities, arguments and restrictions.','suid--sgid--capabilities':'Find privileged executables and validate their effective operations.','cron-timers-services-and-short-lived-processes':'Identify a privileged consumer and the input you can control.','path-hijacking':'Check whether a privileged process resolves a command through your PATH.','wildcard-option-injection':'Inspect how a privileged command expands controlled filenames.','writable-account-and-policy-files':'Verify effective write access to account or authorization configuration.','groups-sockets-and-containers':'Connect your group or socket access to a more privileged identity.','mounts-nfs-local-services-and-libraries':'Inspect mounted resources and consumers reachable from this host.','softwarekernel-candidates--last':'Match the exact build and configuration after assessing permissions.','automated-candidate-generation':'Choose a deeper survey when the first pass leaves a specific gap.','failure-quick-map':'Use the failure symptom to choose the next check.','verify-and-re-enumerate':'Confirm the new identity and revisit access gained through it.','discover-and-recognize-candidates':'Compare observations with worked recognition examples.'};
let current:HTMLDetailsElement|undefined;
for(const node of [...article.children]){
 const heading=node.matches('h2')?node:node.matches('details')?node.querySelector(':scope > summary h2'):null;
 if(heading){let task:HTMLDetailsElement;
  if(node instanceof HTMLDetailsElement)task=node;
  else{task=document.createElement('details');const summary=document.createElement('summary');node.before(task);task.append(summary);summary.append(node);}
  current=task;task.classList.add('prototype-task');task.open=false;
  const summary=task.querySelector(':scope > summary')!;const old=summary.querySelector('.method-choice-cue');
  const cue=document.createElement('span');cue.className='task-cue';cue.textContent=cues[heading.id]||old?.textContent||'Validate the enabling conditions, then choose the supported method.';old?.remove();summary.append(cue);
  const controls=document.createElement('div');controls.className='section-controls';
  for(const [label,expand] of [['Expand this section',true],['Collapse this section',false]] as const){const button=document.createElement('button');button.type='button';button.textContent=label;button.addEventListener('click',()=>{for(const d of task.querySelectorAll('details'))d.open=expand;task.open=expand;});controls.append(button);}summary.after(controls);
 }else if(current)current.append(node);
}
// Opening a task reveals its baseline while keeping conditional alternatives folded.
for(const task of article.querySelectorAll('.prototype-task')){const first=task.querySelector(':scope > details');if(first instanceof HTMLDetailsElement&&/baseline|initial check/i.test(first.querySelector('summary')?.textContent||''))first.open=true;}
void import('../../../scripts/oscp-plain-client');
</script>
