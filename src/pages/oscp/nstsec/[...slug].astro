---
import snapshot from '../../../content/oscp-nstsec.snapshot.json';
export function getStaticPaths(){return [{params:{slug:undefined},props:{page:null}},...snapshot.pages.map(page=>({params:{slug:page.slug},props:{page}}))];}
const {page}=Astro.props;
const groups:snapshotGroup[]=[];
type snapshotGroup={title:string;url:string;children:typeof snapshot.pages};
for(const item of snapshot.pages){if(!item.depth)groups.push({title:item.title,url:item.url,children:[]});else groups.at(-1)?.children.push(item);}
const active=groups.find(g=>g.url===page?.url||g.children.some(p=>p.url===page?.url));
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="color-scheme" content="light"/><meta name="robots" content="noindex,nofollow"/><title>{page?.title||'OSCP notes'}</title></head>
<body>
<header><a href="/oscp/nstsec/">OSCP notes</a><label>Find a page <input id="find" type="search" placeholder="SMB, Kerberos, services…" autocomplete="off"/></label><a href="/oscp/library/">Detailed reference</a></header>
<nav aria-label="Tracks"><a href="/oscp/nstsec/">Start</a>{groups.map(group=><section>{group.children.length?<details open={active===group}><summary><a href={group.url}>{group.title}</a></summary>{group.children.map(item=><a href={item.url} aria-current={item.url===page?.url?'page':undefined}>{item.title}</a>)}</details>:<a href={group.url} aria-current={group.url===page?.url?'page':undefined}>{group.title}</a>}</section>)}</nav>
<main><div id="results" hidden></div><article>{page?<Fragment set:html={page.html}/>:<><h1>OSCP notes</h1><p>Choose the service or technique you are working on.</p><ul>{groups.map(g=><li><a href={g.url}>{g.title}</a></li>)}</ul><p>Keep the command, check the result, then choose the next technique. The <a href="/oscp/reference/INDEX/">detailed reference</a> is available when you need more explanation.</p></>}</article><footer>Adapted from <a href="https://oscp.nstsec.com/">NSTSec / Astaruf’s OSCP notes</a>, with local additions. Source examples are being reviewed; publication does not mean every command is current or exam-permitted.</footer></main>
<aside aria-label="On this page">{page&&<><strong>On this page</strong><ul>{page.headings.filter(h=>h.depth>1&&h.depth<4).map(h=><li class:list={{sub:h.depth===3}}><a href={'#'+h.slug} set:html={h.text}/></li>)}</ul></>}</aside>
<script is:inline define:vars={{pages:snapshot.pages.map(p=>({title:p.title,url:p.url,text:p.html.replace(/<[^>]*>/g,' ')}))}}>
const input=document.getElementById('find'),results=document.getElementById('results');
input.addEventListener('input',()=>{const q=input.value.trim().toLowerCase();results.replaceChildren();results.hidden=!q;if(!q)return;const matches=pages.filter(p=>(p.title+' '+p.text).toLowerCase().includes(q)).sort((a,b)=>Number(b.title.toLowerCase().includes(q))-Number(a.title.toLowerCase().includes(q))).slice(0,12);for(const p of matches){const a=document.createElement('a');a.href=p.url;a.textContent=p.title;results.append(a);}if(!matches.length)results.textContent='No matching pages.';});
</script>
<style is:global>
*{box-sizing:border-box}html{scroll-padding-top:5rem}body{margin:0;background:#fff;color:#202020;font:16px/1.6 system-ui,sans-serif}a{color:#0645ad;text-decoration:underline}a:focus-visible,input:focus-visible,summary:focus-visible{outline:3px solid #2865c7;outline-offset:3px}header{position:fixed;inset:0 0 auto;z-index:2;min-height:64px;display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:12px 24px;background:#fff;border-bottom:1px solid #ddd}header label{font-size:13px}input{margin-left:10px;padding:8px;width:min(32vw,400px)}nav{position:fixed;top:80px;bottom:0;left:0;width:235px;overflow:auto;padding:0 18px 24px;font-size:14px}nav>a,nav section{display:block;margin:0 0 14px}nav details>a{display:block;margin:8px 0 8px 18px}nav [aria-current=page]{font-weight:700;color:#111}summary{cursor:pointer}main{margin:90px 245px 0 260px;max-width:1000px;min-width:0}h1{font-size:30px}h2{font-size:23px;border-bottom:1px solid #ddd;padding-top:14px}h3{font-size:18px}pre{overflow:auto;padding:14px;background:#f5f6f7;border:1px solid #ddd;line-height:1.5;font-size:14px}code{font-family:Consolas,monospace}p code,li code{background:#f1f3f5;padding:2px 4px}blockquote{margin:16px 0;padding:2px 14px;border-left:3px solid #b1bfd0;background:#f4f7fb}img{max-width:100%;height:auto}table{border-collapse:collapse;display:block;max-width:100%;overflow:auto}td,th{border:1px solid #ddd;padding:8px}aside{position:fixed;right:18px;top:90px;bottom:12px;overflow:auto;width:205px;font-size:13px}aside ul{padding-left:0;list-style:none}aside li{margin:8px 0}aside .sub{padding-left:12px}footer{border-top:1px solid #ddd;margin-top:50px;padding:18px 0;font-size:12px;color:#555}#results{border:1px solid #ddd;padding:15px;margin-bottom:24px}#results a{display:block;margin:6px}mark{color:inherit!important;background:#fff0bf;padding:1px 3px}@media(min-width:1600px){main{margin-right:auto}}@media(max-width:1050px){aside{display:none}main{margin-right:24px}}@media(max-width:700px){header{position:sticky;flex-wrap:wrap;padding:10px 14px}header>a:last-child{font-size:12px}input{width:45vw}nav{position:static;width:auto;padding:18px;border-bottom:1px solid #ddd}nav section{display:inline-block;vertical-align:top;margin:8px 16px 8px 0}main{margin:24px 16px}pre{font-size:13px}}
</style>
</body></html>
