---
import snapshot from '../../../content/oscp-nstsec.snapshot.json';
import '../../../styles/oscp-notes.css';
import { preparedNotes, searchPages } from '../../../lib/nstsec-search-index';
import { serializeSearchIndex } from '../../../lib/nstsec-search';
export function getStaticPaths(){const miscPage={path:'misc.md',slug:'misc',url:'/oscp/nstsec/misc/',title:'Misc',depth:0,headings:[],html:'<h1>Misc</h1><p>Standalone study guides.</p><ul><li><a href="/oscp/nstsec/misc/linwinpwn-quick-use.html">AD first pass — direct collectors without menus</a></li><li><a href="/oscp/manual-exploitation/">Manual exploitation — finding to execution</a></li><li><a href="/oscp/nstsec/misc/active-directory-oscp-speedrun.html">Active Directory OSCP speedrun</a></li><li><a href="/oscp/nstsec/misc/windows-privesc-oscp-speedrun.html">Windows privilege escalation OSCP speedrun</a></li></ul>'};return [{params:{slug:'misc'},props:{page:miscPage}},{params:{slug:undefined},props:{page:null}},...snapshot.pages.map(page=>({params:{slug:page.slug},props:{page}}))];}
const {page}=Astro.props;
const groups:snapshotGroup[]=[];
type snapshotGroup={title:string;url:string;children:typeof snapshot.pages};
for(const item of snapshot.pages.filter(p=>!['tools.md','public-exploit-finder.md'].includes(p.path))){if(!item.depth)groups.push({title:item.title,url:item.url,children:[]});else groups.at(-1)?.children.push(item);}
const active=groups.find(g=>g.url===page?.url||g.children.some(p=>p.url===page?.url));
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="color-scheme" content="light"/><meta name="robots" content="noindex,nofollow"/><title>{page?.title||'OSCP notes'}</title></head>
<body>
<a class="skip-link" href="#content">Skip to notes</a>
<header><a class="brand" href="/oscp/">OSCP notes</a><label class="search-label"><span class="sr-only">Search notes</span><input id="find" type="search" placeholder="Search notes…" autocomplete="off" aria-controls="results" aria-expanded="false"/></label><a class="library-link" href="/oscp/library/">Extended library</a></header>
<div id="search-backdrop" hidden aria-hidden="true"></div>
<details class="track-browser" id="track-browser" open><summary class="track-toggle">Browse tracks</summary><nav aria-label="Tracks"><a class="start-link" href="/oscp/nstsec/" aria-current={!page?'page':undefined}>Overview</a><a href="/oscp/nstsec/tools/" aria-current={page?.path==='tools.md'?'page':undefined}>Extra tools to obtain</a><a href="/oscp/nstsec/public-exploit-finder/" aria-current={page?.path==='public-exploit-finder.md'?'page':undefined}>Public exploit finder</a><a href="/oscp/nstsec/misc/" aria-current={page?.path==='misc.md'?'page':undefined}>Misc</a>{groups.map(group=><section>{group.children.length?<details open={active===group}><summary><a href={group.url} aria-current={group.url===page?.url?'page':undefined}>{group.title}</a></summary>{group.children.map(item=><a href={item.url} aria-current={item.url===page?.url?'page':undefined}>{item.title}</a>)}</details>:<a href={group.url} aria-current={group.url===page?.url?'page':undefined}>{group.title}</a>}</section>)}</nav></details>
<main id="content"><div id="search-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div><div id="results" hidden role="region" aria-label="Search results"></div>{page&&<p class="breadcrumb"><a href="/oscp/nstsec/">Notes</a>{active&&<> / <a href={active.url}>{active.title}</a></>}</p>}<article>{page?<Fragment set:html={preparedNotes.get(page.url)?.html || page.html}/>:<><h1>OSCP notes</h1><p class="lead">Commands and checks for the task in front of you.</p><ul class="track-index">{groups.map(g=><li><a href={g.url}>{g.title}</a>{g.children.length>0&&<span>{g.children.length} topics</span>}</li>)}</ul><p class="secondary">Need more detail? Open the <a href="/oscp/library/">extended library</a> for additional procedures and explanations.</p></>}</article><footer>Adapted from <a href="https://oscp.nstsec.com/">NSTSec / Astaruf’s OSCP notes</a>, with local additions. <span>Source examples are under review.</span></footer></main>
<aside aria-label="On this page">{page&&<><strong>On this page</strong><ul>{page.headings.filter(h=>h.depth>1&&h.depth<4).map(h=><li class:list={{sub:h.depth===3}}><a href={'#'+h.slug} set:html={h.text}/></li>)}</ul></>}</aside>
<script is:inline id="notes-search-data" type="application/json" set:html={serializeSearchIndex(searchPages)}></script>
<script>import '../../../scripts/nstsec-search';</script>
</body></html>
