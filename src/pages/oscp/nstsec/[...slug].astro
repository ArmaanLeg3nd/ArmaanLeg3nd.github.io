---
import snapshot from '../../../content/oscp-nstsec.snapshot.json';
import '../../../styles/oscp-notes.css';
export function getStaticPaths(){return [{params:{slug:undefined},props:{page:null}},...snapshot.pages.map(page=>({params:{slug:page.slug},props:{page}}))];}
const {page}=Astro.props;
const groups:snapshotGroup[]=[];
type snapshotGroup={title:string;url:string;children:typeof snapshot.pages};
for(const item of snapshot.pages.filter(p=>p.path!=='tools.md')){if(!item.depth)groups.push({title:item.title,url:item.url,children:[]});else groups.at(-1)?.children.push(item);}
const active=groups.find(g=>g.url===page?.url||g.children.some(p=>p.url===page?.url));
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="color-scheme" content="light"/><meta name="robots" content="noindex,nofollow"/><title>{page?.title||'OSCP notes'}</title></head>
<body>
<a class="skip-link" href="#content">Skip to notes</a>
<header><a class="brand" href="/oscp/">OSCP notes</a><label class="search-label"><span class="sr-only">Search notes</span><input id="find" type="search" placeholder="Search notes…" autocomplete="off" aria-controls="results"/></label><a class="library-link" href="/oscp/library/">Extended library</a></header>
<details class="track-browser" id="track-browser" open><summary class="track-toggle">Browse tracks</summary><nav aria-label="Tracks"><a class="start-link" href="/oscp/nstsec/" aria-current={!page?'page':undefined}>Overview</a><a href="/oscp/nstsec/tools/" aria-current={page?.path==='tools.md'?'page':undefined}>Extra tools to obtain</a>{groups.map(group=><section>{group.children.length?<details open={active===group}><summary><a href={group.url} aria-current={group.url===page?.url?'page':undefined}>{group.title}</a></summary>{group.children.map(item=><a href={item.url} aria-current={item.url===page?.url?'page':undefined}>{item.title}</a>)}</details>:<a href={group.url} aria-current={group.url===page?.url?'page':undefined}>{group.title}</a>}</section>)}</nav></details>
<main id="content"><div id="results" hidden aria-label="Search results"></div>{page&&<p class="breadcrumb"><a href="/oscp/nstsec/">Notes</a>{active&&<> / <a href={active.url}>{active.title}</a></>}</p>}<article>{page?<Fragment set:html={page.html}/>:<><h1>OSCP notes</h1><p class="lead">Commands and checks for the task in front of you.</p><ul class="track-index">{groups.map(g=><li><a href={g.url}>{g.title}</a>{g.children.length>0&&<span>{g.children.length} topics</span>}</li>)}</ul><p class="secondary">Need more detail? Open the <a href="/oscp/library/">extended library</a> for additional procedures and explanations.</p></>}</article><footer>Adapted from <a href="https://oscp.nstsec.com/">NSTSec / Astaruf’s OSCP notes</a>, with local additions. <span>Source examples are under review.</span></footer></main>
<aside aria-label="On this page">{page&&<><strong>On this page</strong><ul>{page.headings.filter(h=>h.depth>1&&h.depth<4).map(h=><li class:list={{sub:h.depth===3}}><a href={'#'+h.slug} set:html={h.text}/></li>)}</ul></>}</aside>
<script is:inline define:vars={{pages:snapshot.pages.map(p=>({title:p.title,url:p.url,text:p.html.replace(/<[^>]*>/g,' ')}))}}>
const input=document.getElementById('find'),results=document.getElementById('results');
input.addEventListener('input',()=>{const q=input.value.trim().toLowerCase();results.replaceChildren();results.hidden=!q;if(!q)return;const matches=pages.filter(p=>(p.title+' '+p.text).toLowerCase().includes(q)).sort((a,b)=>Number(b.title.toLowerCase().includes(q))-Number(a.title.toLowerCase().includes(q))).slice(0,12);for(const p of matches){const a=document.createElement('a');a.href=p.url;a.textContent=p.title;results.append(a);}if(!matches.length)results.textContent='No matching pages.';});
input.addEventListener('keydown',event=>{if(event.key==='Escape'){input.value='';input.dispatchEvent(new Event('input'));}if(event.key==='ArrowDown')results.querySelector('a')?.focus();});
const browser=document.getElementById('track-browser'),narrow=matchMedia('(max-width: 760px)');
browser.open=!narrow.matches;narrow.addEventListener('change',event=>browser.open=!event.matches);
</script>
</body></html>
