---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
---

<BaseLayout>
  <main class="page home-page">
    <section class="intro" aria-labelledby="intro-heading">
      <div class="intro-copy" data-reveal>
        <p class="eyebrow"><span class="signal" aria-hidden="true"></span> Armaan / @ArmaanLeg3nd</p>
        <h1 id="intro-heading">Security engineering.<br />AI and <em>software.</em></h1>
        <p class="intro-description">I'm Armaan, a security engineer who also works on agentic engineering and software development. I build security tools, develop AI agent workflows, and create developer utilities.</p>
        <div class="intro-links"><a class="button button--solid" href="#projects">Explore projects <span aria-hidden="true">↓</span></a><a class="github-link" href="https://github.com/ArmaanLeg3nd">Find me on GitHub <span aria-hidden="true">↗</span></a></div>
      </div>
      <aside class="index-note" aria-label="Project focus" data-reveal>
        <span class="label">An ongoing collection</span>
        <p>Built to solve a problem.<br />Shared for the next one.</p>
        <div><span>01 / Security engineering</span><span>02 / Agentic engineering</span><span>03 / Developer tools</span></div>
      </aside>
    </section>
    <ProjectGrid />
    <div class="closing"><span class="label">More on GitHub</span><p>Source, documentation, and the occasional unfinished idea.</p><a href="https://github.com/ArmaanLeg3nd?tab=repositories">Browse the rest <span aria-hidden="true">↗</span></a></div>
  </main>
</BaseLayout>

<style>
  .home-page { padding-top: clamp(3.5rem, 7vw, 6rem); }
  .intro { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 1fr); gap: 3rem; align-items: end; padding-bottom: clamp(4rem, 8vw, 7rem); }
  .eyebrow { display: flex; align-items: center; gap: .6rem; margin: 0 0 1.8rem; color: var(--muted); font-size: .63rem; letter-spacing: .06em; }
  .signal { width: 6px; height: 6px; background: var(--cyan); border-radius: 50%; }
  h1 { margin: 0; font-size: clamp(2.6rem, 5.4vw, 4.6rem); font-weight: 500; letter-spacing: -.065em; line-height: 1.06; }
  h1 em { color: var(--cyan-soft); font-style: normal; }
  .intro-description { max-width: 49ch; margin: 1.6rem 0 0; color: var(--muted); font-size: 1rem; line-height: 1.8; }
  .intro-links { display: flex; flex-wrap: wrap; align-items: center; gap: 1.4rem; margin-top: 2rem; }
  .intro-links .button { gap: 1.5rem; }
  .github-link { color: var(--muted); font: .68rem var(--mono); }
  .index-note { border-left: 1px solid var(--line-strong); padding-left: 1.4rem; padding-bottom: .3rem; }
  .index-note .label { font-size: .56rem; color: var(--muted); }
  .index-note p { margin: 1rem 0 1.7rem; font-size: 1rem; line-height: 1.5; letter-spacing: -.02em; }
  .index-note div { display: grid; gap: .65rem; color: var(--muted); font: .57rem var(--mono); }
  .closing { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: .7rem 2rem; margin-top: 3rem; padding: 2rem 0 0; }
  .closing .label { grid-column: 1 / -1; margin: 0; color: var(--muted); font-size: .6rem; }
  .closing p { margin: 0; color: var(--muted); font-size: .85rem; }
  .closing a { color: var(--cyan-soft); font: .66rem var(--mono); }
  a:focus-visible { outline: 2px solid var(--cyan); outline-offset: 5px; }
  @media (max-width: 820px) { .intro { grid-template-columns: 1fr; gap: 2.5rem; } .index-note { display: none; } }
  @media (max-width: 480px) { .closing { grid-template-columns: 1fr; gap: 1rem; } }
</style>
