---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectGrid from "../../components/ProjectGrid.astro";
---
<BaseLayout title="Projects | Armaan" description="Open-source security projects, agentic workflows, developer utilities, and interactive tools built by Armaan.">
  <main class="page page--compact">
    <header class="projects-intro" data-reveal><p class="eyebrow">Armaan / Projects & tools</p><h1>Things I've built.</h1><p>Security tooling, agentic engineering, and developer utilities. Explore the source on GitHub or use the interactive tools right here.</p><a class="projects-tools-link" href="/tools/">Open interactive tools <span aria-hidden="true">↗</span></a></header>
    <ProjectGrid />
  </main>
</BaseLayout>
<style>
  .projects-intro { max-width: 43rem; margin-bottom: 4rem; }
  h1 { font-size: clamp(2.5rem, 6vw, 4.5rem); font-weight: 500; line-height: 1.1; letter-spacing: -.06em; margin: 1rem 0; }
  .projects-intro > p:last-child { color: var(--muted); max-width: 54ch; line-height: 1.8; }
  .projects-intro > p:not(.eyebrow) { color: var(--muted); max-width: 54ch; line-height: 1.8; }
  .projects-tools-link { display: inline-flex; gap: 1rem; color: var(--cyan-soft); font: .68rem var(--mono); margin-top: .5rem; transition: color var(--motion-duration) ease; }
</style>
