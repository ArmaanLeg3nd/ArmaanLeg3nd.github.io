---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import Workspace from '../../../../components/oscp/Workspace.svelte';
import { catalog } from '../../../../lib/oscp';
import { stageGuides } from '../../../../lib/oscp-map';
export function getStaticPaths() { return catalog.stages.map(stage => ({params:{stage:stage.id},props:{stage}})); }
const { stage } = Astro.props;
---
<ToolLayout title={`${stageGuides[stage.id].title} map | OSCP`} description={`Decision map for ${stage.title.toLowerCase()}: recognition clues, prerequisites and linked task notes.`}><Workspace client:load {catalog} initialStage={stage.id}/></ToolLayout>
