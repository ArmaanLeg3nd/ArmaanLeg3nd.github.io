---
import ToolLayout from '../../../../layouts/ToolLayout.astro';
import Workspace from '../../../../components/oscp/Workspace.svelte';
import { catalog, topicMethods } from '../../../../lib/oscp';
export function getStaticPaths() { return catalog.methods.map(method => ({ params: { topic: method.topic, method: method.id }, props: { method } })); }
const { method } = Astro.props;
const initialMethods = (await topicMethods(method.topic)).filter(item => item.id === method.id);
---
<ToolLayout title={`${method.title} | OSCP`} description={method.clue}><Workspace client:load {catalog} initialTopic={method.topic} initialMethod={method.id} {initialMethods} /></ToolLayout>
