---
import ToolLayout from '../../layouts/ToolLayout.astro';
import tools from '../../content/tools.json';
---
<ToolLayout title="Tools" description="Interactive security tools for investigation, recognition, and attack-path reasoning.">
  <main class="page tools-directory"><header data-reveal><p class="eyebrow">Armaan / Interactive tools</p><h1>Tools for the work.</h1><p class="tools-intro">Focused workspaces for understanding a problem, following evidence, and deciding what comes next.</p></header>
    <div class="tools-cards">{tools.map((tool,index) => <a class="tool-card" href={tool.href} data-reveal><span class="tool-card-label">{String(index+1).padStart(2,'0')} / {tool.category.toUpperCase()}</span><h2>{tool.title} <span aria-hidden="true">↗</span></h2><p>{tool.summary}</p><div>{tool.facts.map(fact => <span>{fact}</span>)}</div></a>)}</div>
  </main>
</ToolLayout>
