---
interface Stat {
  label: string;
  value: string | number;
}

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  accent?: "cyan" | "white";
  stats?: Stat[];
}

const { eyebrow, title, description, accent = "white", stats = [] } = Astro.props;
---

<header class="page-header" data-accent={accent} data-reveal>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  <p class="description">{description}</p>
  {stats.length > 0 && (
    <div class="stats" aria-label="Archive statistics">
      {stats.map((stat) => (
        <div>
          <span>{stat.label}</span>
          <strong>{stat.value}</strong>
        </div>
      ))}
    </div>
  )}
</header>

<style>
  .page-header {
    position: relative;
    max-width: 68rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .page-header::after {
    position: absolute;
    bottom: -1.2rem;
    left: 0;
    width: min(36rem, 75vw);
    height: 1px;
    content: "";
    background: linear-gradient(90deg, rgba(183, 111, 67, 0.5), transparent);
  }

  h1 {
    max-width: 18ch;
    margin: 0.6rem 0 0.9rem;
    color: var(--text);
    font-family: var(--sans);
    font-size: clamp(2.25rem, 5.2vw, 4.8rem);
    font-weight: 600;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  [data-accent="cyan"] h1 {
    color: var(--text);
  }

  .description {
    max-width: 68ch;
    margin: 0;
    color: var(--muted);
    font-size: clamp(0.95rem, 1.5vw, 1.08rem);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: 1px;
    max-width: 48rem;
    margin-top: 2rem;
    border: 1px solid var(--line);
    background: var(--line);
  }

  .stats div {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.8rem 1rem;
    background: var(--surface-low);
  }

  .stats span,
  .stats strong {
    font-family: var(--mono);
    line-height: 1;
  }

  .stats span {
    color: var(--quiet);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .stats strong {
    color: var(--text);
    font-size: 0.95rem;
  }
</style>
