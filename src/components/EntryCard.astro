---
interface Props {
  href: string;
  kicker: string;
  status: string;
  title: string;
  summary: string;
  meta?: string;
  tags?: string[];
  dense?: boolean;
}

const { href, kicker, status, title, summary, meta, tags = [], dense = false } = Astro.props;
const tone = status.toLowerCase().replaceAll(" ", "-");
---

<article class:list={["entry-card", "panel", "record-card", { dense }]} data-reveal>
  <a href={href} aria-label={`Open ${title}`}>
    <div class="card-topline">
      <span>{kicker}</span>
      <span class="status-chip" data-tone={tone}>{status}</span>
    </div>
    <h3>{title}</h3>
    <p>{summary}</p>
    <div class="card-footer">
      {meta && <span>{meta}</span>}
      <div>{tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}</div>
    </div>
  </a>
</article>

<style>
  .entry-card {
    min-width: 0;
    transition: border-color 180ms ease, background 180ms ease, transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .entry-card:hover,
  .entry-card:focus-within {
    border-color: rgba(231, 225, 214, 0.32);
    background: rgba(30, 33, 33, 0.94);
    transform: translateY(-1px);
  }

  a {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: 100%;
    flex-direction: column;
    padding: 1.35rem;
    outline: none;
  }

  .card-topline,
  .card-footer,
  .card-footer div {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .card-topline {
    justify-content: space-between;
    margin-bottom: 1.25rem;
    color: var(--quiet);
    font-family: var(--mono);
    font-size: 0.625rem;
  }

  h3 {
    margin: 0 0 0.7rem;
    color: var(--text);
    font-family: var(--sans);
    font-size: 1.12rem;
    font-weight: 600;
    line-height: 1.35;
    transition: color 180ms ease;
  }

  .entry-card:hover h3,
  .entry-card:focus-within h3 {
    color: var(--text);
  }

  p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .card-footer {
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.4rem;
    color: var(--quiet);
    font-family: var(--mono);
    font-size: 0.6rem;
  }

  .card-footer div {
    flex-wrap: wrap;
    justify-content: end;
  }

  .dense a {
    padding: 1rem;
  }

  .dense h3 {
    font-size: 0.92rem;
  }

  .dense p {
    font-size: 0.82rem;
  }
</style>
