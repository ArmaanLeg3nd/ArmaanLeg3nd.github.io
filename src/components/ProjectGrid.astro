---
import projects from "../content/projects.json";
---

<section id="projects" aria-labelledby="projects-heading">
  <div class="section-heading">
    <div><p class="eyebrow">Public repositories / 01—{projects.length.toString().padStart(2, "0")}</p><h2 id="projects-heading">Selected projects<span> ({projects.length.toString().padStart(2, "0")})</span></h2></div>
    <a class="all-projects" href="https://github.com/ArmaanLeg3nd?tab=repositories">All repositories <span aria-hidden="true">↗</span></a>
  </div>
  <div class="project-grid">
    {projects.map((project, index) => (
      <article class="project-card" data-reveal>
        <div class="project-top"><span>{String(index + 1).padStart(2, "0")}</span><span>{project.category}</span></div>
        <h3><a href={project.repo}>{project.name}<span aria-hidden="true">↗</span></a></h3>
        <p class="summary">{project.summary}</p>
        <ul class="stack" aria-label="Technologies">{project.stack.map(item => <li>{item}</li>)}</ul>
        {project.note && <p class="attribution">{project.note}</p>}
        <div class="project-links"><a href={project.repo}>Source code <span aria-hidden="true">↗</span></a>{project.link && <a href={project.link.href}>{project.link.label} <span aria-hidden="true">↗</span></a>}</div>
      </article>
    ))}
  </div>
</section>

<style>
  section { scroll-margin-top: 6rem; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--line-strong); }
  .eyebrow { margin: 0 0 .8rem; color: var(--muted); font-size: .62rem; }
  h2 { margin: 0; font-size: clamp(1.6rem, 3vw, 2rem); letter-spacing: -.045em; font-weight: 500; line-height: 1.2; }
  h2 span { color: var(--quiet); font: .75rem var(--mono); letter-spacing: 0; white-space: nowrap; }
  .all-projects { color: var(--muted); font: .68rem var(--mono); white-space: nowrap; }
  .all-projects span { margin-left: .5rem; color: var(--cyan); }
  .project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); border-top: 0; }
  .project-card { display: flex; flex-direction: column; min-width: 0; padding: clamp(1.4rem, 3vw, 2rem); background: var(--bg); transition: background 180ms ease; }
  .project-card:hover { background: var(--surface); }
  .project-top { display: flex; justify-content: space-between; gap: 1rem; color: var(--muted); font: .62rem var(--mono); }
  .project-top > span:first-child { color: var(--ember); }
  h3 { margin: 2.3rem 0 .85rem; font-size: clamp(1.25rem, 2vw, 1.6rem); font-weight: 500; line-height: 1.25; letter-spacing: -.035em; }
  h3 a { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  h3 span { color: var(--quiet); font-size: 1.1rem; }
  .summary { margin: 0 0 1.4rem; color: var(--muted); font-size: .92rem; line-height: 1.7; }
  .stack { display: flex; flex-wrap: wrap; gap: .45rem; padding: 0; margin: auto 0 0; list-style: none; }
  .stack li { border: 1px solid var(--line); padding: .22rem .5rem; color: var(--muted); font: .6rem/1.5 var(--mono); }
  .attribution { color: var(--muted); font-size: .72rem; line-height: 1.6; margin: 1rem 0 0; }
  .project-links { display: flex; flex-wrap: wrap; gap: .7rem 1.25rem; margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--line); color: var(--cyan-soft); font: .65rem/1.6 var(--mono); }
  a:hover { color: var(--cyan); }
  a:focus-visible { outline: 2px solid var(--cyan); outline-offset: 5px; }
  @media (max-width: 640px) { .project-grid { grid-template-columns: 1fr; } .section-heading { align-items: start; flex-direction: column; gap: 1rem; } h3 { margin-top: 1.8rem; } }
</style>
