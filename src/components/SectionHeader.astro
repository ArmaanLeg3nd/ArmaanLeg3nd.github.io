---
interface Props {
  label: string;
  source?: string;
  href?: string;
  linkLabel?: string;
}

const { label, source, href, linkLabel = "Open archive" } = Astro.props;
---

<div class="section-header" data-reveal>
  <div>
    <h2>{label}</h2>
    {source && <p>{source}</p>}
  </div>
  {href && <a href={href}>{linkLabel} <span aria-hidden="true">-&gt;</span></a>}
</div>

<style>
  .section-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--line);
  }

  h2,
  p {
    margin: 0;
  }

  h2 {
    color: var(--text);
    font-family: var(--sans);
    font-size: clamp(1.15rem, 2vw, 1.55rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  p {
    margin-top: 0.35rem;
    color: var(--quiet);
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.03em;
  }

  a {
    flex: 0 0 auto;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.65rem;
    letter-spacing: 0.04em;
  }

  a:hover,
  a:focus-visible {
    color: var(--text);
    outline: none;
  }
</style>
