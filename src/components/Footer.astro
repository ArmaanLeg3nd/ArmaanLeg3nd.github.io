---
import site from "../content/site.json";
import tools from "../content/tools.json";

interface Props {
  links: Array<{ label: string; href: string }>;
  currentPath: string;
}

const { links, currentPath } = Astro.props;
const isActive = (href: string) => href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<footer class="site-footer">
  <div class="footer-inner">
    <nav class="footer-links" aria-label="Footer navigation">
      {links.map(({ label, href }) => <a href={href} aria-current={isActive(href) ? "page" : undefined}>{label}</a>)}
    </nav>
    {site.sections.tools.enabled && <nav class="footer-tools" aria-label="Interactive tools"><span>Interactive tools</span>{tools.map(tool => <a href={tool.href} aria-current={currentPath.startsWith(tool.href) ? "page" : undefined}>{tool.title} <span aria-hidden="true">↗</span></a>)}</nav>}
    <div class="footer-meta">
      <p>© {new Date().getFullYear()} Armaan. Built with curiosity.</p>
      <div>
        {site.socials.map((social) => (
          <a href={social.href} target={social.href.startsWith("http") ? "_blank" : undefined} rel="noreferrer">
            {social.label}
          </a>
        ))}
        <span>{site.timezone}</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 2;
    border-top: 1px solid var(--line);
    background: rgba(8, 12, 16, 0.92);
  }

  .footer-inner {
    width: min(100%, var(--container));
    margin-inline: auto;
    padding: 2rem var(--gutter);
  }

  .footer-links,
  .footer-meta,
  .footer-meta div {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .footer-links {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .footer-links a,
  .footer-meta {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.625rem;
  }

  .footer-tools { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.5rem; padding-top: 1.25rem; font: .625rem var(--mono); color: var(--muted); }
  .footer-tools > span { color: var(--quiet); font-size: .55rem; text-transform: uppercase; letter-spacing: .06em; }
  .footer-tools a:hover, .footer-links a[aria-current="page"] { color: var(--cyan-soft); }
  .site-footer a { transition: color var(--motion-duration) ease; }
  .site-footer :is(.footer-links,.footer-meta,.footer-tools) a:focus-visible { outline: 2px solid var(--cyan); outline-offset: 5px; }

  .footer-links a:hover,
  .footer-links a:focus-visible,
  .footer-meta a:hover,
  .footer-meta a:focus-visible {
    color: var(--cyan);
    outline: none;
  }

  .footer-meta {
    justify-content: space-between;
    padding-top: 1.5rem;
    color: var(--quiet);
  }

  .footer-meta p {
    margin: 0;
  }

  @media (max-width: 620px) {
    .footer-inner {
      padding-inline: 1rem;
    }

    .footer-meta {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
